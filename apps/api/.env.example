# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection used by the pg pool
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carenest
# Optional dedicated database for automated tests (Vitest), e.g. a separate
# Neon database. DB-backed tests fall back to a local URL when this is unset.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/carenest_test
# Maximum connections in the pool (optional)
DATABASE_POOL_MAX=10

# Allowed browser origin(s) for CORS during local development
CLIENT_URL=http://localhost:3000

# Auth signing secret — REQUIRED, at least 32 characters. Generate one locally,
# e.g. `openssl rand -hex 32`. Never commit the real secret.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# AI provider key (backend-only, never expose to the frontend)
GROQ_API_KEY=replace_with_provider_key
# Groq model used for AI visit structuring (optional, defaults shown)
GROQ_MODEL=llama-3.3-70b-versatile
# Groq chat completions endpoint (optional, override only for a proxy/mock)
GROQ_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Timeout in ms for a single AI structuring request (optional)
AI_REQUEST_TIMEOUT_MS=20000

# Groq Whisper model used for speech-to-text (optional, defaults shown)
GROQ_STT_MODEL=whisper-large-v3-turbo
# Groq speech-to-text endpoint (optional, override only for a proxy/mock)
GROQ_STT_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
# Timeout in ms for a single speech-to-text request (optional)
STT_REQUEST_TIMEOUT_MS=30000
# Max accepted audio upload size in bytes (optional; default 25 MB matches
# Groq's free-tier limit — raise it only if the account is on a paid tier)
STT_MAX_AUDIO_BYTES=26214400